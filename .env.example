# AISA Frontend - Environment Variables Template
# Copy this file to '.env' and fill in the values for local development.

# Base API URL pointing to the AISA backend server
VITE_AISA_BACKEND_API=http://localhost:8080/api

# Google OAuth Client ID for social login integration
AISA_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Razorpay key ID for checkout payments
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Link back to the parent AI Mall platform
VITE_AI_MALL=https://aimall24.com
